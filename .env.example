# Copy to .env and customize:  cp .env.example .env
#
# docker-compose reads .env from this directory. Running without Docker, the
# backend reads backend/.env instead — same variables either way. Both are
# gitignored and must never be committed.

# --- Storage -----------------------------------------------------------------
# Directory holding feeds.db and the image caches. Defaults to backend/data.
# The Docker image sets this to /app/backend/data, which is the mounted volume.
DATA_DIR=

# --- Docker port binding ------------------------------------------------------
# Where docker-compose publishes the app on the host. The defaults keep it on
# loopback, reachable only from the machine running Docker.
#
# For LAN access set BIND_ADDR=0.0.0.0, and change HOST_PORT if something else
# already owns 8001 on that host. Set a password immediately either way: until
# you do, every API route is open to anyone who can reach the port.
BIND_ADDR=127.0.0.1
HOST_PORT=8001

# --- Networking --------------------------------------------------------------
# Comma-separated CORS allow-list. Leave blank to allow only local dev servers
# and the Capacitor Android bundle. Add your public hostname when deploying:
#   CORS_ORIGINS=https://reader.example.com
CORS_ORIGINS=

# Public base URL used when generating RSS and OPML links. Set this when running
# behind a reverse proxy or tunnel, otherwise links use the request host.
#   PUBLIC_URL=https://reader.example.com
PUBLIC_URL=

# --- Translation -------------------------------------------------------------
# DeepSeek is the primary translator; Google Translate is the automatic fallback
# and needs no key. DeepL is legacy and optional.
DEEPSEEK_API_KEY=
DEEPL_API_KEY=

# --- Article topic tagging ---------------------------------------------------
# Thinking is disabled by default: on deepseek-v4-flash the reasoning pass cost
# roughly 7x the output and none of it is retained. Set to "enabled" to restore.
TAGGING_MODEL=deepseek-v4-flash
TAGGING_THINKING=disabled

# --- Optional: FlareSolverr ---------------------------------------------------
# Bypasses Cloudflare interstitials on sites that use them. The backend degrades
# gracefully when this is unset or unreachable. With docker-compose, uncomment
# the flaresolverr service and use http://flaresolverr:8191/v1
FLARESOLVERR_URL=

# --- Optional: hardening ------------------------------------------------------
# reCAPTCHA secret for the login form. Only effective when the frontend is also
# configured with the matching site key; setting one without the other rejects
# every login attempt.
RECAPTCHA_SECRET_KEY=

# Allow the fetcher to reach private and loopback addresses. Off by default as
# SSRF protection. Set to 1 only if you deliberately fetch from your own LAN.
ALLOW_PRIVATE_IP_FETCH=0
